<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Out-of-process importer: reads a ClrMD snapshot of the running game and builds the rank-Yu
    solver's Battle and Rules. The assembly name matches the InternalsVisibleTo entry of
    vendor/sts2-solver/src/Core so the importer can use the same internal kernel helpers as the
    upstream in-process importer (src/Import/Combat), which this project ports.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Sts2Solver.Import</AssemblyName>
    <RootNamespace>Sts2Solver.LiveImport</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <ProjectReference Include="../vendor/sts2-solver/src/Core/Sts2Solver.Core.csproj" />
    <Compile Include="../reader/RulesCatalogFile.cs" Link="RulesCatalogFile.cs" />
    <!-- Static, game-independent table from the upstream importer (BCL only). -->
    <Compile Include="../vendor/sts2-solver/src/Import/Combat/MirrorRiskTables.cs" Link="Upstream/MirrorRiskTables.cs" />
    <Compile Include="../vendor/sts2-solver/src/Import/Combat/UnsupportedImportException.cs" Link="Upstream/UnsupportedImportException.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    In-game executor mod: a tiny localhost HTTP server that plays the solver's route inside the game
    (card, potion, end turn) through the game's own action queue. All reading and solving stay in the
    out-of-process reader; this mod only executes. Builds against the installed game assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Sts2Executor</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <Sts2Data Condition="'$(Sts2Data)' == ''">E:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</Sts2Data>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(Sts2Data)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2Data)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2Data)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
